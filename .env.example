# Local development: copy to backend/.env. Compose: copy to .env at repo root.
DATABASE_URL=sqlite:///./astra.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_NASA_NETWORK=true
NASA_CACHE_SECONDS=3600
# Compose only. Change this before hosting. Use URL-safe characters.
POSTGRES_PASSWORD=astra_local_development_only
# Optional frontend build-time variable; empty uses the Vite/nginx API proxy.
VITE_API_URL=
